# Copie para .env e preencha a(s) chave(s).  (NÃO commite o .env.)

# Chave da API do Google Gemini (https://aistudio.google.com/app/apikey)
# Necessária para EMBEDDINGS (indexar/consultar) mesmo com o chat roteado pelo OpenRouter.
GEMINI_API_KEY=

# Modelos do Gemini direto (centralizados — troque aqui se houver rate-limit/deprecação)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Variantes por peso p/ o roteamento inteligente (vazio = usa o padrão do papel)
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
GEMINI_MODEL_HEAVY=

# --- Roteamento de modelos (OpenRouter — https://openrouter.ai/keys) ---
# Com OPENROUTER_API_KEY preenchida (e LLM_BACKEND=auto), o CHAT (planner/geração/juiz) passa a
# ser roteado pelo OpenRouter: troca de modelo/provedor por .env, fallback automático entre
# modelos e custo real por chamada. EMBEDDINGS continuam no Gemini/local (não há embeddings lá).
# LLM_BACKEND: auto | openrouter | gemini
LLM_BACKEND=auto
OPENROUTER_API_KEY=
# Slugs "provedor/modelo" (catálogo: https://openrouter.ai/models). "openrouter/auto" delega
# a escolha do modelo ao roteador do OpenRouter.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_PLANNER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_LIGHT=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_HEAVY=
# Juiz de OUTRA família de modelo (mitiga o viés de auto-avaliação Gemini->Gemini)
OPENROUTER_JUDGE_MODEL=anthropic/claude-haiku-4.5
# Fallback ordenado entre modelos (resiliência: se o primário falhar, tenta o próximo)
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4.5
# Roteamento de PROVEDOR para o mesmo modelo: vazio (padrão) | price | throughput | latency
OPENROUTER_SORT=

# --- Economia de tokens (fluxo completo: docs/economia_de_tokens.md) ---
# Roteamento INTELIGENTE por solicitação (tier light/standard/heavy decidido em Python)
SMART_ROUTING=true
# Teto de tokens de SAÍDA por chamada (bound de custo; 0 desliga)
LLM_MAX_OUTPUT_TOKENS=1024
# Cache de CHAMADAS ao LLM (memória limitada; persistência em disco opcional p/ re-rodar eval grátis)
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_ENTRIES=512
LLM_CACHE_PERSIST=false
LLM_TIMEOUT_S=60

# Backend de embeddings: "gemini" (padrão) ou "local" (offline, exige sentence-transformers)
EMBEDDINGS_BACKEND=gemini
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=768

# Parâmetros de recuperação / comportamento
CURRENT_YEAR=2026
TOP_K=8
RRF_K=60
TITLE_MATCH_THRESHOLD=90
LLM_TEMPERATURE=0
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92

# URL do backend para a UI Streamlit e scripts de avaliação
API_BASE_URL=http://127.0.0.1:8000

# --- Segurança (ver SECURITY.md) ---
# Origens permitidas no CORS (UI). Restrinja em produção.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Rate limit por IP no /ask (req/min; 0 desliga). Teto de custo acumulado por processo (USD; 0 desliga).
RATE_LIMIT_RPM=30
DAILY_COST_CAP_USD=5.0
# Confiar em X-Forwarded-For? Só true se estiver ATRÁS de um proxy confiável (senão o IP é forjável).
TRUST_PROXY=false
# Tamanho máx dos caches em memória (anti-DoS). Logar a pergunta crua? (LGPD: false em produção)
MAX_CACHE_ENTRIES=1000
LOG_QUESTIONS=true
