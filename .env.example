# Copie para .env e preencha a chave.  (NÃO commite o .env.)

# Chave da API do Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modelos (centralizados — troque aqui se houver rate-limit/deprecação)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Backend de embeddings: "gemini" (padrão) ou "local" (offline, exige sentence-transformers)
EMBEDDINGS_BACKEND=gemini
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=768

# Parâmetros de recuperação / comportamento
CURRENT_YEAR=2026
TOP_K=8
RRF_K=60
TITLE_MATCH_THRESHOLD=90
LLM_TEMPERATURE=0

# URL do backend para a UI Streamlit e scripts de avaliação
API_BASE_URL=http://127.0.0.1:8000
