# Segredos
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Cache de chamadas LLM persistido em disco (opcional, LLM_CACHE_PERSIST=true) — regenerável
data/llm_cache/

# Feedback de usuários reais (👍/👎 por resposta) — dado de uso, não código; fica fora do repo
data/feedback.jsonl

# Saídas de avaliação geradas (dumps brutos grandes — regeneráveis pelos scripts de eval)
eval/results_manual.json
eval/results_judge.json

# Dashboard de KPIs: HTML 100% gerado por scripts/build_dashboard.py.
# Reconstruído sob demanda em GET /kpis, então não precisa ser versionado.
dashboard/

# COMMITADOS DE PROPÓSITO (baseline p/ o revisor abrir o dashboard OFFLINE, sem chave):
#   - data/embeddings.npy + data/embeddings_meta.json -> recuperação offline, sem re-embeddar
#   - eval/gold.json                                   -> gold-set curado (anti-circular)
#   - eval/results_retrieval.json                      -> métricas de recuperação (gerado, mas fixado)
#   - eval/results_manual.md                           -> contém os RÓTULOS MANUAIS humanos
# Por isso esses NÃO entram no .gitignore.
